    "subtitles": true,
    "visual": {"background": "grid", "animation": "spring", "pace": "progressive"},
    "narration": [
      {"text": "左侧代码创建字符串，再将所有权移动给第二个变量。", "target": 1},
      {"text": "右上方是用于理解的栈到堆示意图。", "target": 2},
      {"text": "这里要注意，移动之后不能继续使用原来的变量。", "target": 3}
