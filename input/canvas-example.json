    "props": {
      "heading": "所有权移动：代码、图解与提示同屏",
      "layout": "split-2-1",
      "blocks": [
        {"id": "code", "type": "CodeBlock", "props": {"language": "rust", "code": "let s1 = String::from(\"hello\");\nlet s2 = s1;"}},
        {"id": "sidebar", "type": "GroupBlock", "layout": "stacked", "blocks": [
          {"id": "diagram", "type": "DiagramBlock", "props": {"heading": "简化内存示意", "nodes": ["Stack", "Heap"], "activeNode": 2}},
